# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Comma-separated allowed origins. Use '*' only for local dev.
CORS_ORIGINS=*

# AWS (DynamoDB Local defaults)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMODB_ENDPOINT=http://localhost:8000

# DynamoDB tables
MESSAGES_TABLE=messages-table
IDEMPOTENCY_TABLE=idempotency-table

# Kafka
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=messages-api
KAFKA_GROUP_ID=messages-worker
KAFKA_EVENTS_TOPIC=message-events
KAFKA_EVENTS_DLQ_TOPIC=message-events-dlq
KAFKA_CONSUMER_MAX_ATTEMPTS=3
KAFKA_CONSUMER_RETRY_BASE_MS=200
KAFKA_PRODUCER_ACKS=-1

# Auth (demo stub — replace with real IdP)
DEMO_PASSWORD=demo

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m

# Idempotency
IDEMPOTENCY_TTL_SECONDS=86400
