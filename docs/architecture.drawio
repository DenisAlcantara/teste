        </mxCell>
        <mxCell id="subtitle" value="NestJS + DynamoDB (sincrono)  -  Kafka + Worker (assincrono)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
