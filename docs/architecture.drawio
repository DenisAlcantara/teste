        <mxCell id="kafka" value="Kafka&#10;&#10;message-events&#10;message-events-dlq" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=12;spacingTop=12;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="500" width="240" height="140" as="geometry" />
        </mxCell>

